# ==============================================================================
# Arkidi Backend Environment Variables
# Archdiocese of Kigali Digital Archive & Parish Management System
# ==============================================================================

# Environment (development, testing, production)
ENVIRONMENT=development
APP_NAME="Arkidi Platform API"
APP_VERSION="1.0.0"

# Server Host & Port
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL + PostGIS Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=arkidi_db
DATABASE_USER=arkidi_user
DATABASE_PASSWORD=arkidi_secure_password_dev_2026
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Connection
REDIS_URL=redis://localhost:6379/0
SECURITY_CRITICAL_MODE=false

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Authentication & Security
SECRET_KEY=super_secure_arkidi_platform_archdiocese_of_kigali_secret_key_32bytes_min
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000","http://localhost:3000"]

# File Storage & Uploads
FILE_STORAGE_PATH=./file-storage
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=[".pdf",".jpg",".jpeg",".png",".doc",".docx",".xls",".xlsx"]

# Backup & Archival Storage
BACKUP_BASE_PATH=./backups
GCS_ENABLED=false
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_CREDENTIALS_PATH=
B2_ENABLED=false
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# Email / SMTP Notifications
SMTP_SERVER=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_SENDER=noreply@archidiocesekigali.org

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/arkidi.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Internationalization (i18n)
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=["en","fr","rw"]
