# ==============================================================================
# Arkidi Platform — Production Environment Template
# Archdiocese of Kigali Digital Archive & Parish Management System
# ==============================================================================
# Copy this file to .env.production and fill in real production values.
# This template is committed to version control.
# Never store real secrets in .env.production.example — use placeholders.

# ─── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=production
APP_NAME="Arkidi Platform API"
APP_VERSION="1.0.0"

# ─── Server ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── PostgreSQL / PostGIS ──────────────────────────────────────────────────────
# In Docker Compose (prod), DATABASE_HOST is set to "postgres" internally.
# For an external DB, set DATABASE_HOST to the actual hostname.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=arkidi_db
DATABASE_USER=arkidi_user
DATABASE_PASSWORD=<<SET_YOUR_PRODUCTION_DB_PASSWORD>>
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ─── Redis (Cache, Celery Broker, Token Blacklist) ──────────────────────────────
REDIS_URL=redis://:<<SET_REDIS_PASSWORD>>@redis:6379/0
# Fail closed on security-critical Redis failures (token revocation/check).
SECURITY_CRITICAL_MODE=true

# ─── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:<<SET_REDIS_PASSWORD>>@redis:6379/1
CELERY_RESULT_BACKEND=redis://:<<SET_REDIS_PASSWORD>>@redis:6379/2

# ─── JWT / Security ────────────────────────────────────────────────────────────
# Generate a strong key:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<<GENERATE_A_SECURE_48+CHAR_KEY>>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Replace with your actual production origin(s).
CORS_ORIGINS=["https://app.arkidi.org"]

# ─── TLS / Public site (frontend nginx) ───────────────────────────────────────
# Public domain served by the frontend Nginx container (TLS termination).
# Paths are interpreted inside the frontend container; the corresponding files
# must be bind-mounted (see docker-compose.prod.yml).
SERVER_NAME=app.arkidi.org
SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
SSL_KEY_PATH=/etc/nginx/certs/privkey.pem

# ─── File Storage & Uploads ────────────────────────────────────────────────────
FILE_STORAGE_PATH=/app/file-storage
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=[".pdf",".jpg",".jpeg",".png",".doc",".docx",".xls",".xlsx"]

# ─── Backup & Archival Storage ─────────────────────────────────────────────────
BACKUP_BASE_PATH=/app/backups
# Scheduled backup service (docker-compose.prod.yml `backup` service).
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24

# ─── Cloud Offsite Backup (google-cloud-storage / b2sdk) ───────────────────────
# Leave both disabled (false) for local-only backups.  Enable one or both for
# real offsite redundancy — backup.sh will upload each artefact via
# scripts/cloud_upload.py after creating the local dump & tarball.
GCS_ENABLED=false
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_CREDENTIALS_PATH=/app/secrets/gcs-key.json

B2_ENABLED=false
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# ─── Backup / Restore-Drill Alerting (Celery Beat) ─────────────────────────────
# Comma-separated list of recipients for backup / restore-drill failure alerts.
# When unset, alerts go to EMAIL_SENDER.
ALERT_RECIPIENTS=chancelier@archidiocesekigali.org,dio_it@archidiocesekigali.org

# ─── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.arkidi.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_SENDER=noreply@archidiocesekigali.org

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE_PATH=/app/logs/arkidi.log
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=10

# ─── Internationalization (i18n) ───────────────────────────────────────────────
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=["en","fr","rw"]

# ─── Docker Compose (docker-compose.prod.yml) — variable interpolation ─────────
# These variables are consumed by docker-compose.prod.yml for the Postgres
# container and backend/celery service environment blocks.
POSTGRES_DB=arkidi_db
POSTGRES_USER=arkidi_user
POSTGRES_PASSWORD=<<SET_YOUR_PRODUCTION_DB_PASSWORD>>
POSTGRES_PORT=5432
REDIS_PASSWORD=<<SET_REDIS_PASSWORD>>