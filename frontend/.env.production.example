# Arkidi Frontend — Production Environment Template
#
# Copy to .env.production and adjust for your deployment.
# Public only — no secrets here. Vite loads .env.production during `vite build`.
#
# The production Nginx container serves the SPA and reverse-proxies /api/* to
# the FastAPI backend, so the API base URL is same-origin (/api/v1). Set an
# absolute URL instead only if you terminate the API on a separate subdomain.
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME="Arkidi Platform"
VITE_DEFAULT_LANGUAGE=en