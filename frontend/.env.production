# ==============================================================================
# Arkidi Frontend — Production Environment
# ==============================================================================
# Vite automatically loads .env.production during `vite build` / production mode.
# This file contains only public configuration (no secrets) and is committed to
# version control. Use .env.production.local to override for local builds.

VITE_API_BASE_URL=https://api.arkidi.org/api/v1
VITE_APP_NAME="Arkidi Platform"
VITE_DEFAULT_LANGUAGE=en
