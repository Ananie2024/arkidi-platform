# Arkidi Frontend — Production Environment (committed template/value file)
#
# Vite loads .env.production during `vite build` (production mode). Public only.
# Override locally with .env.production.local for machine-specific builds.
#
# The production Nginx container serves the SPA and reverse-proxies /api/* to
# the FastAPI backend, so the API base URL is same-origin. Set an absolute URL
# instead only if you terminate the API on a separate subdomain.
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME="Arkidi Platform"
VITE_DEFAULT_LANGUAGE=en