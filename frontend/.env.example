# Arkidi Frontend Environment Configuration
#
# IMPORTANT: Anything prefixed VITE_ is exposed to the browser at runtime and is
# therefore PUBLIC. Never place API keys, passwords, or SECRET_KEY values here.
# Copy this file to .env.local and override with your own local values.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="Arkidi Platform"
VITE_DEFAULT_LANGUAGE=en
